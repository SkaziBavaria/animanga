{
  "name": "animanga",
  "version": "0.3.3",
  "private": false,
  "description": "Self-hosted anime player and manga reader",
  "license": "MIT",
  "type": "commonjs",
  "bin": {
    "animanga": "bin/animanga.js"
  },
  "files": [
    "bin",
    "lib",
    "public",
    "server.js",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SkaziBavaria/animanga.git"
  },
  "homepage": "https://github.com/SkaziBavaria/animanga#readme",
  "bugs": {
    "url": "https://github.com/SkaziBavaria/animanga/issues"
  },
  "keywords": [
    "anime",
    "manga",
    "self-hosted",
    "pwa"
  ],
  "scripts": {
    "start": "node server.js",
    "prepack": "npm run check",
    "check": "npm run lint && npm run test:unit",
    "lint": "eslint .",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node scripts/run-node-tests.js tests/unit",
    "test:contract": "node scripts/run-node-tests.js tests/contract",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:smoke:npm": "node scripts/smoke-npm.js",
    "test:smoke:docker": "node scripts/smoke-docker.js"
  },
  "engines": {
    "node": ">=22.16"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "eslint": "^10.7.0",
    "globals": "^17.8.0"
  }
}
